local function CreateCard(player)
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local card = Instance.new("BillboardGui")
    card.Name = "QuantumCard"
    card.Adornee = root
    card.Size = UDim2.new(0, 220, 0, 80)
    card.StudsOffset = Vector3.new(0, 3.5, 0)
    card.AlwaysOnTop = true
    card.Parent = root
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = Color3.fromRGB(20, 10, 15)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Parent = card
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
    
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = Color3.fromRGB(255, 150, 200)
    stroke.Thickness = 2
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -10, 0.4, 0)
    nameLabel.Position = UDim2.new(0, 10, 0, 5)
    nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.Text = player.DisplayName or player.Name
    nameLabel.TextSize = 18
    nameLabel.Font = Enum.Font.GothamBold
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = frame
    
    local hpLabel = Instance.new("TextLabel")
    hpLabel.Size = UDim2.new(1, -10, 0.3, 0)
    hpLabel.Position = UDim2.new(0, 10, 0, 40)
    hpLabel.BackgroundTransparency = 1
    hpLabel.TextColor3 = Color3.fromRGB(255, 200, 210)
    hpLabel.Text = "❤️ " .. math.floor(hum.Health) .. "/" .. hum.MaxHealth
    hpLabel.TextSize = 14
    hpLabel.Font = Enum.Font.Gotham
    hpLabel.TextXAlignment = Enum.TextXAlignment.Left
    hpLabel.Parent = frame
    
    local weapon = char:FindFirstChildOfClass("Tool")
    local weaponLabel = Instance.new("TextLabel")
    weaponLabel.Size = UDim2.new(1, -10, 0.3, 0)
    weaponLabel.Position = UDim2.new(0, 10, 0, 60)
    weaponLabel.BackgroundTransparency = 1
    weaponLabel.TextColor3 = Color3.fromRGB(255, 220, 230)
    weaponLabel.Text = "🔫 " .. (weapon and weapon.Name or "无武器")
    weaponLabel.TextSize = 13
    weaponLabel.Font = Enum.Font.Gotham
    weaponLabel.TextXAlignment = Enum.TextXAlignment.Left
    weaponLabel.Parent = frame
    
    table.insert(cardObjects, card)
    return card
end

