local function ClearFlyEffects()
    for _, obj in pairs(flyParticles) do
        pcall(function() obj:Destroy() end)
    end
    flyParticles = {}
end

local function StartFly()
    local char = game.Players.LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    ClearFlyEffects()
    CreateFlyEffects(char)
    
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Name = "北极星飞行"
    bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bodyVel.Velocity = Vector3.new(0, 0, 0)
    bodyVel.Parent = hrp
    
    table.insert(flyParticles, bodyVel)
    
    if flyConnection then flyConnection:Disconnect() end
    flyConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not flyEnabled or not char or not char.Parent then
            return
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local up = Vector3.new(0, 1, 0)
        local forward = hrp.CFrame.LookVector
        local right = hrp.CFrame.RightVector
        
        local vel = Vector3.new(0, 0, 0)
        local input = game:GetService("UserInputService")
        
        if input:IsKeyDown(Enum.KeyCode.W) then
            vel = vel + forward * flySpeed
        end
        if input:IsKeyDown(Enum.KeyCode.S) then
            vel = vel - forward * flySpeed
        end
        if input:IsKeyDown(Enum.KeyCode.A) then
            vel = vel - right * flySpeed
        end
        if input:IsKeyDown(Enum.KeyCode.D) then
            vel = vel + right * flySpeed
        end
        if input:IsKeyDown(Enum.KeyCode.Space) then
            vel = vel + up * flySpeed
        end
        if input:IsKeyDown(Enum.KeyCode.LeftShift) then
            vel = vel - up * flySpeed
        end
        
        if vel.Magnitude > 0 then
            bodyVel.Velocity = vel
        else
            bodyVel.Velocity = Vector3.new(0, 0, 0)
        end
        
        local head = char:FindFirstChild("Head")
        if head then
            local left = char:FindFirstChild("北极星角_左")
            local right = char:FindFirstChild("北极星角_右")
            if left then
                left.CFrame = head.CFrame * CFrame.new(-0.8, 0.5, 0) * CFrame.Angles(0, 0, math.rad(-20))
            end
            if right then
                right.CFrame = head.CFrame * CFrame.new(0.8, 0.5, 0) * CFrame.Angles(0, 0, math.rad(20))
            end
        end
    end)
end

local function StopFly()
    flyEnabled = false
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    ClearFlyEffects()
    local char = game.Players.LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("北极星飞行")
            if bv then bv:Destroy() end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
        end
    end
end

